#!/bin/vbash

source /opt/vyatta/etc/functions/script-template

WAN_MAC="{{ .WanMac }}"
LAN_MAC="{{ .LanMac }}"
WAN_IF="eth0"
LAN_IF="eth1"

configure
delete interfaces ethernet

set interfaces ethernet "$WAN_IF" hw-id "$WAN_MAC"
set interfaces ethernet "$WAN_IF" address dhcp

set interfaces ethernet "LAN_IF" hw-id "$LAN_MAC"
set interfaces ethernet "$LAN_IF" address '192.168.50.1/24'

commit
save
exit
